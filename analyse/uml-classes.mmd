%% ═════════════════════════════════════════════════════════════
%% Diagramme de classes – Modèle entité-relation
%% Classes principales uniquement : Utilisateur, Livre, Emprunt
%% (les services, DTO et repositories ne font pas partie du modèle)
%% ═════════════════════════════════════════════════════════════
classDiagram
    direction LR

    class Utilisateur {
        +Long id
        +String nom
        +String email
        +String password
        +RoleUser role
    }

    class Livre {
        +Long id
        +String titre
        +String auteur
        +String categorie
        +boolean disponible
    }

    class Emprunt {
        +Long id
        +LocalDate dateEmprunt
        +LocalDate dateRetourPrevue
        +EmpruntStatus statut
    }

    class RoleUser {
        <<enumeration>>
        ADMIN
        USER
    }

    class EmpruntStatus {
        <<enumeration>>
        EN_COURS
        TERMINE
    }

    %% ── Associations (cardinalités UML) ──
    Utilisateur "1" --> "0..*" Emprunt : effectue
    Livre "1" --> "0..*" Emprunt : concerné par

    %% ── Énumérations liées aux entités ──
    Utilisateur ..> RoleUser : utilise
    Emprunt ..> EmpruntStatus : utilise
